#include <string.h>

int minimumRecolors(char* blocks, int k) {
    int len = strlen(blocks);
    int current_w = 0;
    
    // Count 'W' blocks in the first window of size k
    for (int i = 0; i < k; i++) {
        if (blocks[i] == 'W') {
            current_w++;
        }
    }
    
    int min_w = current_w;
    
    // Slide the window across the rest of the string
    for (int i = k; i < len; i++) {
        if (blocks[i - k] == 'W') {
            current_w--;
        }
        if (blocks[i] == 'W') {
            current_w++;
        }
        
        if (current_w < min_w) {
            min_w = current_w;
        }
    }
    
    return min_w;
}
