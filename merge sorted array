void merge(int* nums1, int nums1Size, int m, int* nums2, int nums2Size, int n) {
    // Pointers for the end of valid elements in nums1 and nums2
    int p1 = m - 1;
    int p2 = n - 1;
    
    // Pointer for the last available slot in the overall nums1 array
    int p = m + n - 1;
    
    // Traverse backwards until we empty nums2
    while (p2 >= 0) {
        // If nums1 still has elements and its current element is larger
        if (p1 >= 0 && nums1[p1] > nums2[p2]) {
            nums1[p] = nums1[p1];
            p1--;
        } else {
            nums1[p] = nums2[p2];
            p2--;
        }
        p--;
    }
}
