#include <string.h>
#include <stdbool.h>
#include <ctype.h>

char* longestNiceSubstring(char* s) {
    int len = strlen(s);
    if (len < 2) return "";

    // Track presence of lowercase and uppercase characters
    bool has_lower[26] = {false};
    bool has_upper[26] = {false};
    
    for (int i = 0; i < len; i++) {
        if (islower(s[i])) has_lower[s[i] - 'a'] = true;
        if (isupper(s[i])) has_upper[s[i] - 'A'] = true;
    }

    // Find the first character that breaks the nice rule
    for (int i = 0; i < len; i++) {
        char c = s[i];
        if ((islower(c) && !has_upper[c - 'a']) || (isupper(c) && !has_lower[c - 'A'])) {
            // Split the string at index i
            s[i] = '\0'; // Temporarily terminate for left substring
            char* left = longestNiceSubstring(s);
            char* right = longestNiceSubstring(s + i + 1);
            
            // Compare lengths and return the optimal one
            if (strlen(left) >= strlen(right)) {
                return left;
            } else {
                return right;
            }
        }
    }

    return s;
}
