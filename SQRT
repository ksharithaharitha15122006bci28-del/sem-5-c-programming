int mySqrt(int x) {
    // Base cases for 0 and 1
    if (x == 0 || x == 1) {
        return x;
    }
    
    int left = 1, right = x, ans = 0;
    
    while (left <= right) {
        int mid = left + (right - left) / 2;
        
        // Use division instead of mid * mid to avoid integer overflow
        if (mid <= x / mid) {
            ans = mid;     // mid could be the potential answer
            left = mid + 1; // Try to find a larger value
        } else {
            right = mid - 1; // mid is too large, search the lower half
        }
    }
    
    return ans;
}
